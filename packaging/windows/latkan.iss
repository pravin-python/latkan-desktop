; Latkan - Inno Setup 6.3+ installer script.
;
; Per-user install (no administrator rights, no UAC prompt) into %LOCALAPPDATA%\Programs\Latkan.
;
; Normally invoked by scripts/build.py. Manual use, from the repository root, after PyInstaller:
;   iscc /DMyAppVersion=1.0.0 packaging\windows\latkan.iss
;
; Inputs : dist\Latkan\          PyInstaller onedir output (Latkan.exe + _internal\)
;          assets\icon.ico       optional, generated by scripts/make_icons.py
; Output : dist\Latkan-<version>-windows-x64-setup.exe

#ifndef MyAppVersion
  #define MyAppVersion "0.0.0-dev"
#endif
#ifndef MyAppArch
  #define MyAppArch "x64"
#endif

#define MyAppName      "Latkan"
#define MyAppExeName   "Latkan.exe"
#define MyAppPublisher "Latkan contributors"
; "Start at login" registry value. Must stay identical to the one latkan/platform/windows.py manages.
#define RunKey         "Software\Microsoft\Windows\CurrentVersion\Run"
#define RunValue       "Latkan"
; Where Task Manager / Settings > Startup record "disabled" for a Run entry.
#define ApprovedKey    "Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run"
#define RootDir        AddBackslash(SourcePath) + "..\.."

#if !FileExists(RootDir + "\dist\" + MyAppName + "\" + MyAppExeName)
  #error dist\Latkan\Latkan.exe not found - run PyInstaller first (python scripts/build.py)
#endif

[Setup]
; AppId identifies the product for upgrades/uninstall. Never change it.
AppId={{7822995E-8284-4D4C-B1F4-153B8C90DA80}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppCopyright=Copyright (c) 2026 {#MyAppPublisher}
VersionInfoDescription={#MyAppName} Setup
VersionInfoProductName={#MyAppName}
VersionInfoProductTextVersion={#MyAppVersion}
PrivilegesRequired=lowest
DefaultDirName={localappdata}\Programs\{#MyAppName}
DisableDirPage=yes
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
; Tasks are one-shot: an upgrade never pre-selects what the last install chose, so a silent/winget
; upgrade applies none of them. What an earlier task created (Run value, desktop icon) is left as it
; is: Inno never removes an unselected task's entries during install. Otherwise every upgrade would
; rewrite Run\Latkan and wipe the Task Manager "disabled" flag the user set since.
; Opt in explicitly with /TASKS="autostart" or /MERGETASKS="autostart".
UsePreviousTasks=no
OutputDir={#RootDir}\dist
OutputBaseFilename={#MyAppName}-{#MyAppVersion}-windows-{#MyAppArch}-setup
#if FileExists(RootDir + "\assets\icon.ico")
SetupIconFile={#RootDir}\assets\icon.ico
#endif
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName}
WizardStyle=modern
Compression=lzma2/max
SolidCompression=yes
MinVersion=10.0
#if MyAppArch == "arm64"
ArchitecturesAllowed=arm64
ArchitecturesInstallIn64BitMode=arm64
#else
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
#endif
; Restart Manager: close anything else holding our files (.pyd are loaded modules too).
CloseApplications=yes
CloseApplicationsFilter=*.exe,*.dll,*.pyd
RestartApplications=no
SetupLogging=yes
ShowLanguageDialog=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[CustomMessages]
english.AutoStartTask=Start %1 automatically when I sign in
english.StartupGroup=Startup:

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "autostart"; Description: "{cm:AutoStartTask,{#MyAppName}}"; GroupDescription: "{cm:StartupGroup}"; Flags: unchecked

[InstallDelete]
; PyInstaller output changes between versions; never mix old and new bundled libraries.
Type: filesandordirs; Name: "{app}\_internal"

[Files]
Source: "{#RootDir}\dist\{#MyAppName}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Comment: "Swinging charms for your desktop"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Registry]
; Same key/value/format as the in-app "Start at login" toggle: the quoted executable path.
Root: HKCU; Subkey: "{#RunKey}"; ValueType: string; ValueName: "{#RunValue}"; ValueData: """{app}\{#MyAppExeName}"""; Tasks: autostart; Flags: uninsdeletevalue
; A stale "disabled" flag from Task Manager would keep the fresh Run entry inert. Only runs when the
; user ticks the box in this run (UsePreviousTasks=no), so their later Task Manager choice survives.
Root: HKCU; Subkey: "{#ApprovedKey}"; ValueType: none; ValueName: "{#RunValue}"; Tasks: autostart; Flags: deletevalue

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
const
  RunKey = '{#RunKey}';
  RunValue = '{#RunValue}';
  ApprovedKey = '{#ApprovedKey}';

{ Latkan lives in the tray and has no main window, so the Restart Manager cannot always ask it to
  close. Stop this user's instances so files can be replaced or removed. Settings are saved within
  ~0.4 s of every change, so nothing meaningful is lost. }
procedure StopRunningInstances();
var
  ResultCode: Integer;
begin
  if Exec(ExpandConstant('{sys}\taskkill.exe'),
          '/F /IM {#MyAppExeName} /FI "USERNAME eq ' + GetUserNameString + '"',
          '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
  begin
    Log(Format('taskkill {#MyAppExeName} exit code: %d', [ResultCode]));
    if ResultCode = 0 then
      Sleep(700);
  end;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  StopRunningInstances();
  Result := '';
end;

{ The [Registry] entry above only covers the installer task. The user may also have enabled
  "Start at login" from the tray menu, so remove the value whenever it points at this install
  (a value pointing at another copy, e.g. a source checkout, is left alone). }
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Data: String;
begin
  if CurUninstallStep = usUninstall then
  begin
    StopRunningInstances();
    if RegQueryStringValue(HKCU, RunKey, RunValue, Data) then
    begin
      if Pos(Lowercase(ExpandConstant('{app}')), Lowercase(Data)) > 0 then
      begin
        if RegDeleteValue(HKCU, RunKey, RunValue) then
        begin
          Log('Removed autostart entry: ' + Data);
          RegDeleteValue(HKCU, ApprovedKey, RunValue);
        end
        else
          Log('Could not remove autostart entry: ' + Data);
      end
      else
        Log('Autostart entry points elsewhere, left untouched: ' + Data);
    end;
  end;
end;
